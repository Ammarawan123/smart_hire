"""
concepts_v58.py — the shared concept registry (skills, technologies, practices, domains).

One registry serves résumé skills, JD requirements, answer understanding and question generation, so
"RAG" means the same thing everywhere. Each concept carries:
  * aliases        surface forms to detect (word-boundary safe, symbol-safe: C#, C++, .NET, ASP.NET)
  * category       résumé category: programming_languages | frameworks | libraries | databases | AI_ML | tools | other
                   (JD-only categories: architecture | practice | domain)
  * facets         what *evidence* of real understanding looks like (used for DEMONSTRATED vs THEORETICAL)
  * implies        weaker supporting evidence (YOLO practical => Computer Vision practical, lower weight)
  * q              question text per difficulty level; 'scenario' is the fallback for candidates with no experience
The registry is data, not logic: adding a concept never needs a code change elsewhere.
"""
from __future__ import annotations

import re
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple

LEVELS = ["basic", "impl", "depth", "tradeoff", "debug"]      # controlled difficulty ladder


@dataclass
class Concept:
    key: str
    name: str
    category: str
    kind: str = "technology"             # technology | concept | practice | domain
    aliases: List[str] = field(default_factory=list)
    cs_aliases: List[str] = field(default_factory=list)       # case-sensitive aliases (e.g. "Go", "R")
    item_only: List[str] = field(default_factory=list)        # only valid as a whole skills-list item ("C", "R")
    facets: Dict[str, List[str]] = field(default_factory=dict)
    implies: Dict[str, float] = field(default_factory=dict)
    q: Dict[str, str] = field(default_factory=dict)
    gate: str = ""                        # "Have you worked with <gate>?" phrasing
    cluster: str = ""
    bridge_from: List[str] = field(default_factory=list)      # résumé concepts that can bridge into a grounded question
    bridge_q: str = ""                    # uses {tech} {project}
    library_like: bool = False            # candidates *use* these; "I didn't build it" is not a lack of experience

    def expected_evidence(self) -> List[str]:
        return list(self.facets.keys())


REG: Dict[str, Concept] = {}


def _c(key, name, cat, aliases="", kind="technology", facets=None, implies=None, q=None, gate="", cluster="", bridge_from="", bridge_q="",
       cs="", item_only="", library_like=False):
    c = Concept(key=key, name=name, category=cat, kind=kind,
                aliases=[a.strip() for a in aliases.split("|") if a.strip()] + [name.lower()],
                cs_aliases=[a.strip() for a in cs.split("|") if a.strip()],
                item_only=[a.strip() for a in item_only.split("|") if a.strip()],
                facets=facets or {}, implies=implies or {}, q=q or {}, gate=gate or name, cluster=cluster,
                bridge_from=[b for b in bridge_from.split("|") if b], bridge_q=bridge_q, library_like=library_like)
    REG[key] = c
    return c


