# ── helpers ─────────────────────────────────────────────────────────────────────────────────────
# Concepts that are a *family* the JD names loosely; asking about a specific one satisfies the parent partially.
FAMILY = {"sqlserver": "sql", "mysql": "sql", "postgres": "sql", "oracle": "sql", "sqlite": "sql"}


def _alias_regex(alias: str, cs: bool = False) -> re.Pattern:
    a = re.escape(alias.strip())
    a = a.replace(r"\ ", r"[\s\-_/]*")
    pre = r"(?<![\w+#.])" if re.match(r"[\w.]", alias) else ""
    post = r"(?![\w#])" if re.search(r"[\w]$", alias) else r"(?![\w])"
    if alias.endswith("+"):
        post = r"(?![\w#])"
    return re.compile(pre + a + post, 0 if cs else re.I)


_ALIAS_RX: List[Tuple[re.Pattern, str, str]] = []
_ITEM_MAP: Dict[str, str] = {}
for _k, _cpt in REG.items():
    seen = set()
    for al in sorted(set(_cpt.aliases), key=len, reverse=True):
        if al.lower() in seen or len(al) < 2:
            continue
        seen.add(al.lower())
        _ALIAS_RX.append((_alias_regex(al), _k, al))
        _ITEM_MAP[re.sub(r"[^a-z0-9#+.]", "", al.lower())] = _k
    for al in _cpt.cs_aliases:
        _ALIAS_RX.append((_alias_regex(al, cs=True), _k, al))
    for al in _cpt.item_only:
        _ITEM_MAP[re.sub(r"[^a-z0-9#+.]", "", al.lower())] = _k
_ALIAS_RX.sort(key=lambda t: -len(t[2]))
# "api" alone is ambiguous: only the explicit REST aliases may map from free text, not every "API"
_AMBIGUOUS_ALIASES = {"api", "rest", "ts", "js", "py", "tf", "node", "mongo", "tts", "stt", "map", "eda", "spring", "express", "go", "r", "c", "swift", "dart", "ml", "ai"}


def find_mentions(text: str, allow_ambiguous: bool = False) -> List[Tuple[str, int, int, str]]:
    """Concept mentions as (key, start, end, alias). Longest alias wins on overlap."""
    t = text or ""
    taken: List[Tuple[int, int]] = []
    out = []
    for rx, key, alias in _ALIAS_RX:
        if alias.lower() in _AMBIGUOUS_ALIASES and not allow_ambiguous:
            if alias.lower() in {"api", "rest"}:
                # "api" counts only with an HTTP/web cue next to it
                for m in rx.finditer(t):
                    ctx = t[max(0, m.start() - 24): m.end() + 24].lower()
                    if re.search(r"rest|http|endpoint|json|web|backend|server|request", ctx) and key == "rest_api":
                        if not any(s <= m.start() < e or s < m.end() <= e for s, e in taken):
                            taken.append((m.start(), m.end())); out.append((key, m.start(), m.end(), alias))
            continue
        for m in rx.finditer(t):
            if any(s <= m.start() < e or s < m.end() <= e for s, e in taken):
                continue
            taken.append((m.start(), m.end()))
            out.append((key, m.start(), m.end(), alias))
    out.sort(key=lambda x: x[1])
    return out


def lookup_item(item: str) -> Optional[str]:
    """Resolve a single skills-list item ("scikit-learn", "Unity (C++)", "OpenCV") to a concept key."""
    s = re.sub(r"\(.*?\)", "", item or "").strip()
    k = re.sub(r"[^a-z0-9#+.]", "", s.lower())
    if k in _ITEM_MAP:
        return _ITEM_MAP[k]
    ms = find_mentions(s, allow_ambiguous=True)
    if ms and ms[0][1] == 0 and ms[0][2] >= len(s) - 1:
        return ms[0][0]
    return None


def get(key: str) -> Optional[Concept]:
    return REG.get(key)


def name_of(key: str) -> str:
    c = REG.get(key)
    return c.name if c else key.replace("_", " ").title()


def closure(key: str) -> Dict[str, float]:
    """Everything a practical use of `key` supports (transitive, attenuated)."""
    out: Dict[str, float] = {}
    stack = [(key, 1.0)]
    while stack:
        k, w = stack.pop()
        c = REG.get(k)
        if not c:
            continue
        for t, tw in c.implies.items():
            nw = w * tw
            if nw > 0.1 and nw > out.get(t, 0):
                out[t] = nw
                stack.append((t, nw))
    out.pop(key, None)
    return out


_KW_CACHE: Dict[str, re.Pattern] = {}


def facets_hit(key: str, text_norm: str) -> List[str]:
    c = REG.get(key)
    if not c:
        return []
    out = []
    for f, kws in c.facets.items():
        for kw in kws:
            rx = _KW_CACHE.get(kw)
            if rx is None:
                body = re.escape(kw.rstrip("*")).replace(r"\ ", r"[\s-]+")
                if kw.endswith("*"):
                    body = re.escape(kw[:-1]).replace(r"\ ", r"[\s-]+")
                    rx = _KW_CACHE[kw] = re.compile(r"(?<![a-z0-9])" + body)
                else:
                    rx = _KW_CACHE[kw] = re.compile(r"(?<![a-z0-9])" + body + r"(?:s|es|ed|ing|d)?(?![a-z0-9])")
            if rx.search(text_norm):
                out.append(f)
                break
    return out
